                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "identity": {
                        "type": "object",
                        "properties": {
                          "chainId": {
                            "const": 4663
                          },
                          "registry": {
                            "type": "string",
                            "const": "0x8004a169fb4a3325136eb29fa0ceb6d2e539a432"
                          },
                          "agentId": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$",
                            "description": "Canonical unsigned decimal uint256, less than 2^256."
                          }
                        },
                        "required": [
                          "chainId",
                          "registry",
                          "agentId"
                        ],
                        "additionalProperties": false
                      },
                      "action": {
                        "const": "request_binding"
                      },
                      "payload": {
                        "type": "object",
                        "properties": {
                          "userAddress": {
                            "type": "string",
                            "pattern": "^0x[0-9a-fA-F]{40}$"
                          }
                        },
                        "required": [
                          "userAddress"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "identity",
                      "action",
                      "payload"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "identity": {
                        "type": "object",
                        "properties": {
                          "chainId": {
                            "const": 4663
                          },
                          "registry": {
                            "type": "string",
                            "const": "0x8004a169fb4a3325136eb29fa0ceb6d2e539a432"
                          },
                          "agentId": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$",
                            "description": "Canonical unsigned decimal uint256, less than 2^256."
                          }
                        },
                        "required": [
                          "chainId",
                          "registry",
                          "agentId"
                        ],
                        "additionalProperties": false
                      },
                      "action": {
                        "const": "status"
                      },
                      "payload": {
                        "type": "object",
                        "properties": {},
                        "required": [],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "identity",
                      "action",
                      "payload"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "identity": {
                        "type": "object",
                        "properties": {
                          "chainId": {
                            "const": 4663
                          },
                          "registry": {
                            "type": "string",
                            "const": "0x8004a169fb4a3325136eb29fa0ceb6d2e539a432"
                          },
                          "agentId": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$",
                            "description": "Canonical unsigned decimal uint256, less than 2^256."
                          }
                        },
                        "required": [
                          "chainId",
                          "registry",
                          "agentId"
                        ],
                        "additionalProperties": false
