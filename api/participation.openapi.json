    "/v1/identity/agent/execute": {
      "post": {
        "operationId": "identity_execute",
        "summary": "Execute the exact user-authorized signed identity operation.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challengeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "signature": {
