                          },
                          "agentId": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$",
                            "description": "Canonical unsigned decimal uint256, less than 2^256."
                          }
                        },
                        "required": [
                          "chainId",
                          "registry",
                          "agentId"
                        ],
                        "additionalProperties": false
                      },
                      "action": {
                        "const": "enroll"
                      },
                      "payload": {
                        "type": "object",
                        "properties": {},
                        "required": [],
