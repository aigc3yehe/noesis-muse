{
  "openapi": "3.1.0",
  "info": {
    "title": "NOESIS optional signed participation reference",
    "version": "0.1.0",
    "description": "Independent NOESIS integration. Not a Meta-issued manifest or an approved directory listing. Public API origin only. No trading or private account access."
